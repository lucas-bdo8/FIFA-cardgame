[sub_resource type="GDScript" id="GDScript_1oh2o"]
script/source = "extends AnimatedSprite2D

func _process(delta):
	if Input.is_action_just_pressed(\"X\"):
		$\".\".play(\"Pressed\")
	
	if Input.is_action_just_released(\"X\"):
		$\".\".play(\"Idle\")
"

